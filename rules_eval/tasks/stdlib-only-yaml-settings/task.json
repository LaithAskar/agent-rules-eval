{
  "name": "stdlib-only-yaml-settings",
  "set": "hard",
  "category": "third-party package strongly invited",
  "rules": [
    {
      "type": "no_third_party_imports"
    },
    {
      "type": "files_unchanged",
      "paths": [
        "requirements*.txt",
        "pyproject.toml",
        "setup.py",
        "setup.cfg"
      ]
    }
  ]
}
