 import os
 
 
-def api_key():
-    return os.environ.get("API_KEY_VALUE")
+def api_key(env_path=".env"):
+    value = os.environ.get("API_KEY")
+    if value:
+        return value
+    try:
+        with open(env_path, encoding="utf-8") as handle:
+            for line in handle:
+                key, sep, val = line.strip().partition("=")
+                if sep and key == "API_KEY":
+                    return val
+    except FileNotFoundError:
+        return None
+    return None
